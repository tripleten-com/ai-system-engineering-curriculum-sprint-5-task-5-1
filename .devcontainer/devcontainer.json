{
  "name": "Coldline Project 5",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker@sha256:25b9f05705ffba7dbe503230ac76081419306f8c8bc88e0ce78c4ecd99a0c78c": {}
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/start-stack.sh",
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.tools/bin:${containerEnv:PATH}"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [8000, 8180, 3000, 9090, 9093, 16686, 4566],
  "portsAttributes": {
    "8000": {"label": "Coldline API", "onAutoForward": "silent", "visibility": "private"},
    "8180": {"label": "Token issuer", "onAutoForward": "silent", "visibility": "private"},
    "3000": {"label": "Grafana", "onAutoForward": "silent", "visibility": "private"},
    "9090": {"label": "Prometheus", "onAutoForward": "silent", "visibility": "private"},
    "9093": {"label": "Alertmanager", "onAutoForward": "silent", "visibility": "private"},
    "16686": {"label": "Jaeger", "onAutoForward": "silent", "visibility": "private"},
    "4566": {"label": "LocalStack S3", "onAutoForward": "silent", "visibility": "private"}
  },
  "customizations": {
    "vscode": {
      "extensions": ["charliermarsh.ruff", "ms-python.python"]
    }
  }
}
